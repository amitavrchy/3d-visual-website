generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VISITOR
  ADMIN
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(ADMIN)
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tagline     String
  description String
  coverImage  String
  year        Int?
  clientName  String?
  roles       String[]
  tech        String[]
  sceneConfig Json
  gallery     String[]
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model WorldNote {
  id        String   @id @default(cuid())
  author    String
  message   String
  color     String   @default("#4AF2C8")
  x         Float
  y         Float
  z         Float
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  budget    String?
  message   String
  createdAt DateTime @default(now())
}

model Experiment {
  id         String  @id @default(cuid())
  slug       String  @unique
  title      String
  summary    String
  configJson Json
  published  Boolean @default(false)
}
